<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
        <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
        <section name="quartz" type="System.Configuration.NameValueSectionHandler, System, Version=1.0.5000.0,Culture=neutral, PublicKeyToken=b77a5c561934e089" />
    </configSections>
    <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
        <providers>
            <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="Fanex.Data" enableWatching="1" />
        </providers>
    </Fanex.Data.DbSettingProvider>
    <Fanex.Logging msmqPath="FormatName:DIRECT=http://10.40.40.127/msmq/private$/entlib" defaultCategory="Affiliate-Athena" />
    <connectionStrings configSource="ConnectionString.config" />
    <appSettings configSource="AppSetting.config" />
    <quartz>
        <add key="quartz.threadPool.type" value="Quartz.Simpl.SimpleThreadPool, Quartz" />
        <add key="quartz.threadPool.threadCount" value="10" />
        <add key="quartz.threadPool.threadPriority" value="Normal" />
        <add key="quartz.plugin.xml.type" value="Quartz.Plugin.Xml.XMLSchedulingDataProcessorPlugin, Quartz" />
        <add key="quartz.plugin.xml.fileNames" value="~/QuartzJobs.xml" />
    </quartz>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="ServiceSoap" />
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint address="http://10.2.180.8:8082/service.asmx" binding="basicHttpBinding" bindingConfiguration="ServiceSoap" contract="AffiliateWebService.ServiceSoap" name="ServiceSoap" />
        </client>
    </system.serviceModel>

</configuration>