<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="quartz" type="System.Configuration.NameValueSectionHandler, System, Version=1.0.5000.0,Culture=neutral, PublicKeyToken=b77a5c561934e089" />
    <sectionGroup name="common">
      <section name="logging" type="Common.Logging.ConfigurationSectionHandler, Common.Logging" />
    </sectionGroup>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="Fanex.Affiliate.Services.WinService.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="Fanex.Affiliate.Services.WinService.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
    
  <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" /></configSections>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="Fanex.Data" enableWatching="1" ignoreExceptionIsNotParameters="true" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  <connectionStrings configSource="ConnectionString.config" />
  <appSettings file="AppSetting.config">
    <add key="SentryBackEndDsn" value="http://d3accc8a2adc4dfc8b83ce1355cd2e01@sentry.nexdev.net/77" />
    <add key="LoggingCategory" value="Affiliate-Athena-Service-LOCAL" />
    <add key="Environment" value="LOCAL" />

    <!--UM-->
    <add key="ONEbook.UM:ServiceUri" value="https://onebookum-dev.nexdev.net/api" />
    <add key="ONEbook.UM:EnableCheckUM" value="true" />
    <add key="ONEbook.UM:SiteId" value="2000003" />
    <add key="ONEbook.UM:EnableUnscheduledUM" value="false" />
    <add key="ONEbook.UM:UMFrom" value="1:00" />
    <add key="ONEbook.UM:UMTo" value="23:00" />
    <add key="ONEbook.UM:UMPageUrl" value="~/" />
    <add key="ONEbook.UM:ResultCacheDuration" value="60" />
    <add key="ONEbook.UM:UMLoggingCategory" value="ONEbook-Athena-Service-UM" />
    <add key="ONEbook.UM:ErrorUMPageUrl" value="" />
  </appSettings>
  <quartz>
    <add key="quartz.threadPool.type" value="Quartz.Simpl.SimpleThreadPool, Quartz" />
    <add key="quartz.threadPool.threadCount" value="10" />
    <add key="quartz.threadPool.threadPriority" value="Normal" />
    <add key="quartz.plugin.xml.type" value="Quartz.Plugin.Xml.XMLSchedulingDataProcessorPlugin, Quartz" />
    <add key="quartz.plugin.xml.fileNames" value="~/quartzjobs.xml" />
    <!--<add key="quartz.plugin.xml.scanInterval" value="10" />-->
  </quartz>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="ServiceSoap" />
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://10.2.180.30:8082/service.asmx" binding="basicHttpBinding" bindingConfiguration="ServiceSoap" contract="AffiliateWebService.ServiceSoap" name="ServiceSoap" />
    </client>
  </system.serviceModel>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
    </roleManager>
  </system.web>
</configuration>
