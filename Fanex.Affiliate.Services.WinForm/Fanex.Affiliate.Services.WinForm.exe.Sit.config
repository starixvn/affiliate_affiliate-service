<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>

    <section name="quartz" type="System.Configuration.NameValueSectionHandler, System, Version=1.0.5000.0,Culture=neutral, PublicKeyToken=b77a5c561934e089" />
    <sectionGroup name="common">
      <section name="logging" type="Common.Logging.ConfigurationSectionHandler, Common.Logging" />
    </sectionGroup>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="Fanex.Affiliate.Services.WinService.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="Fanex.Affiliate.Services.WinService.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
  </configSections>


  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="Fanex.Data" enableWatching="1" ignoreExceptionIsNotParameters="true" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  <connectionStrings configSource="ConnectionString.config" />
  <appSettings file="AppSetting.config" >
    <add key="SentryBackEndDsn" value="https://d3accc8a2adc4dfc8b83ce1355cd2e01@sentry.nexdev.net/77"/>
    <add key="LoggingCategory" value="Affiliate-Athena-Service-SIT"/>
    <add key="Environment" value="SIT" />
  </appSettings>
  <quartz>
    <add key="quartz.threadPool.type" value="Quartz.Simpl.SimpleThreadPool, Quartz" />
    <add key="quartz.threadPool.threadCount" value="10" />
    <add key="quartz.threadPool.threadPriority" value="Normal" />
    <add key="quartz.plugin.xml.type" value="Quartz.Plugin.Xml.XMLSchedulingDataProcessorPlugin, Quartz" />
    <add key="quartz.plugin.xml.fileNames" value="~/quartzjobs.xml" />
    <!--<add key="quartz.plugin.xml.scanInterval" value="10" />-->
  </quartz>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="ServiceSoap" />
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://172.16.2.126:38082/service.asmx" binding="basicHttpBinding" bindingConfiguration="ServiceSoap" contract="AffiliateWebService.ServiceSoap" name="ServiceSoap" />
    </client>
  </system.serviceModel>
  <runtime>
  </runtime>
</configuration>